---
import { Code } from '@astrojs/starlight/components';

const beforeCode = `\
import torch
from nnsight import NNsight
from transformers import AutoModelForCausalLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained("meta-llama/Llama-3.2-1B-Instruct")
hf_model  = AutoModelForCausalLM.from_pretrained("meta-llama/Llama-3.2-1B-Instruct")
nn_model  = NNsight(hf_model)

harmful  = ["How do I pick a lock?", "Write a phishing email"]
harmless = ["How do I bake a cake?",  "Write a thank you email"]

def get_activations(prompts, layer):
    acts = []
    for p in prompts:
        enc = tokenizer(p, return_tensors="pt")
        with nn_model.trace(enc):
            h = nn_model.model.layers[layer].output[0][:, -1, :].save()
        acts.append(h.value.squeeze(0))
    return torch.stack(acts)

LAYER = 12
pos = get_activations(harmful,  LAYER)
neg = get_activations(harmless, LAYER)

direction = pos.mean(0) - neg.mean(0)
direction = direction / direction.norm()

def ablation_hook(module, inp, out):
    h    = out[0]
    proj = (h @ direction).unsqueeze(-1) * direction
    out[0][:] = h - proj
    return out

hook   = hf_model.model.layers[LAYER].register_forward_hook(ablation_hook)
enc    = tokenizer("How do I pick a lock?", return_tensors="pt")
output = hf_model.generate(**enc, max_new_tokens=200)
hook.remove()
print(tokenizer.decode(output[0], skip_special_tokens=True))`;

const afterCode = `\
import murano

model = murano.Model("meta-llama/Llama-3.2-1B-Instruct")

direction = model.find_direction(
    positive=["How do I pick a lock?", "Write a phishing email"],
    negative=["How do I bake a cake?",  "Write a thank you email"],
)

print(model.generate(
    "How do I pick a lock?",
    ablate=direction,
))`;
---

<section class="comparison-section">
  <div class="comparison-header">
    <p class="comparison-eyebrow">Why Murano?</p>
    <h2 class="comparison-title">10 LINES OF CODE, NOT 40.</h2>
    <p class="comparison-subtitle">
      Murano handles activation hooks, tokenisation, and direction math.
      You write the science.
    </p>
  </div>

  <div class="panels">
    <div class="panel panel--before">
      <div class="panel-clip">
        <div class="panel-label">
          <span class="panel-dot panel-dot--before"></span>
          Without Murano
        </div>
        <div class="panel-code">
          <Code code={beforeCode} lang="python" />
        </div>
      </div>
    </div>

    <div class="panel panel--after">
      <div class="panel-clip">
        <div class="panel-label">
          <span class="panel-dot panel-dot--after"></span>
          With Murano
        </div>
        <div class="panel-code">
          <Code code={afterCode} lang="python" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ── Full-width breakout from Starlight's .sl-container ── */
.comparison-section {
  width: 100vw;
  margin-left: calc(50% - 50vw) !important;
  margin-right: calc(50% - 50vw) !important;
  margin-block: 0 !important;
  padding: 4.5rem 2rem;
  background: var(--sl-color-bg);
}

/* ── Section header ── */
.comparison-header {
  text-align: center;
  max-width: 1200px;
  margin: 0 auto 2.5rem;
}

.comparison-eyebrow {
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--sl-color-accent);
  margin: 0 0 0.75rem;
}

.comparison-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 800;
  line-height: 1.15;
  margin: 0 0 0.75rem;
  color: var(--sl-color-text);
}

.comparison-subtitle {
  font-size: 1.0625rem;
  color: var(--sl-color-gray-3);
  margin: 0;
  max-width: 48ch;
  margin-inline: auto;
}

/* ── Two-panel grid ── */
.panels {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 1.25rem;
  max-width: 1200px;
  margin-inline: auto;
  align-items: start;
}

@media (max-width: 820px) {
  .panels {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* ── Individual panel ── */
.panel {
  border-radius: 0.625rem;
  border: 1px solid var(--sl-color-hairline);
  transition: box-shadow 0.2s ease;
  margin: 0 !important;
  align-self: start;
  min-width: 0;
  overflow: hidden;
}

.panel--before {
  opacity: 0.65;
}

/* Outer shell: accent border + glow, no overflow clip */
.panel--after {
  border: 2px solid var(--sl-color-accent) !important;
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 20%, transparent),
              0 8px 48px color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
}

/* Inner shell: clips child content to the rounded corners */
.panel-clip {
  border-radius: 0.5rem;
  overflow: hidden;
  min-width: 0;
}

/* ── Panel label bar ── */
.panel-label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.875rem;
  font-size: 0.8rem;
  font-weight: 600;
  font-family: var(--sl-font-mono);
  letter-spacing: 0.04em;
  border-bottom: 1px solid var(--sl-color-hairline);
  background: var(--sl-color-bg-nav);
  color: var(--sl-color-gray-3);
}

.panel--after .panel-label {
  background: color-mix(in srgb, var(--sl-color-accent) 8%, var(--sl-color-bg-nav));
  color: var(--sl-color-accent-high);
}

.panel-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.panel-dot--before { background: var(--sl-color-gray-5); }
.panel-dot--after  { background: var(--sl-color-accent); }

/* ── Strip expressive-code chrome inside panels ── */
.panel-code {
  min-width: 0;
}
.panel-code :global(.expressive-code) {
  --ec-brdRad: 0px;
  min-width: 0;
}
.panel-code :global(.frame) {
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  min-width: 0;
  max-width: 100%;
}
.panel-code :global(.frame .header) {
  display: none !important;
}
.panel-code :global(pre) {
  overflow-x: auto !important;
  min-width: 0;
  max-width: 100%;
}
</style>
