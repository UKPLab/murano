---

<div class="social-bar">
  {links.map((l) => (
    <a href={l.href} class="social-chip" target={l.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">
      <Fragment set:html={l.icon} />
      {l.label}
    </a>
  ))}
</div>

<style>
.social-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem;
  margin: 0 auto !important;
  padding: 0 0 3rem;
  max-width: 100%;
}

.social-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.35rem 0.75rem;
  border-radius: 2rem;
  border: 1px solid var(--sl-color-hairline) !important;
  background: var(--sl-color-bg-nav);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--sl-color-gray-3);
  text-decoration: none !important;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}

.social-chip:hover {
  border-color: var(--sl-color-accent) !important;
  color: var(--sl-color-accent);
  background: color-mix(in srgb, var(--sl-color-accent) 6%, var(--sl-color-bg-nav));
}
</style>
