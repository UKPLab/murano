---
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isRepro = pathname.startsWith(`${base}reproductions`) || pathname.startsWith('/reproductions');
const isDocs = pathname.startsWith(`${base}docs`) || pathname.startsWith('/docs');
---

<nav class="site-nav">
  <a href={`${base}docs/getting-started/overview/`} data-text="Docs" class:list={['site-nav__link', { active: isDocs }]}>Docs</a>
  <a href={`${base}reproductions/`} data-text="Reproduction Gallery" class:list={['site-nav__link', { active: isRepro }]}>Reproduction Gallery</a>
</nav>
<Default {...Astro.props} />

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-right: 0.25rem;
  }

  .site-nav__link {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.2s;
  }

  /* Reserve the width of the bold variant so hover/active don't cause layout shift. */
  .site-nav__link::before {
    content: attr(data-text);
    display: block;
    font-weight: 600;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }

  .site-nav__link:hover { color: var(--sl-color-text); }
  .site-nav__link.active {
    color: var(--sl-color-text);
    font-weight: 600;
  }
</style>
