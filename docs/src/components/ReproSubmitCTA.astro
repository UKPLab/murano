---
---

<section class="submit-section">
  <details class="repro-details">
    <summary class="repro-summary">
      <div class="summary-content">
        <div class="summary-text">
          <h2 class="submit-title">Submit Your Reproduction.</h2>
          <p class="submit-subtitle">
            Upload a Murano-powered notebook and we'll feature it here.
          </p>
        </div>
        <span class="summary-btn">Submit a notebook ↓</span>
      </div>
    </summary>

    <form class="repro-form" onsubmit="return false;">
      <div class="form-row">
        <div class="form-field">
          <label for="rg-name">Your name</label>
          <input id="rg-name" type="text" placeholder="Alice Müller" autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="rg-email">Email</label>
          <input id="rg-email" type="email" placeholder="alice@example.com" autocomplete="email" />
        </div>
      </div>

      <div class="form-field">
        <label for="rg-paper">Paper title or DOI</label>
        <input id="rg-paper" type="text" placeholder="e.g. Representation Engineering (Zou et al., 2023)" />
      </div>

      <div class="form-field">
        <label for="rg-desc">Short description</label>
        <textarea id="rg-desc" rows="3" placeholder="What does your notebook reproduce? Any notes for reviewers."></textarea>
      </div>

      <div class="form-field">
        <label for="rg-file">Notebook (.ipynb)</label>
        <div class="file-drop" id="rg-drop-zone">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="drop-label">Drop your <code>.ipynb</code> here, or <label for="rg-file" class="browse-link">browse</label></span>
          <span class="drop-hint" id="rg-file-name">No file selected</span>
          <input id="rg-file" type="file" accept=".ipynb,application/json" />
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="submit-btn">Submit reproduction</button>
        <span class="form-note">We review all submissions before publishing.</span>
      </div>
    </form>
  </details>
</section>

<script>
  const input = document.getElementById('rg-file') as HTMLInputElement;
  const label = document.getElementById('rg-file-name');
  const zone  = document.getElementById('rg-drop-zone');

  input?.addEventListener('change', () => {
    if (label) label.textContent = input.files?.[0]?.name ?? 'No file selected';
  });

  zone?.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone?.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
  zone?.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('drag-over');
    const file = e.dataTransfer?.files[0];
    if (file && input) {
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      if (label) label.textContent = file.name;
    }
  });
</script>

<style>
.submit-section {
  padding: 2rem 0 5rem;
  display: flex;
  justify-content: center;
}

.repro-details {
  width: 100%;
  max-width: 600px;
  border: 1px solid var(--sl-color-hairline);
  border-radius: 1rem;
  background: var(--sl-color-bg-nav);
  position: relative;
  overflow: hidden;
}

.repro-details::before {
  content: '';
  position: absolute;
  inset: -60px;
  background: radial-gradient(
    ellipse 60% 50% at 50% 0%,
    color-mix(in srgb, var(--sl-color-accent) 12%, transparent),
    transparent 70%
  );
  pointer-events: none;
}

.repro-summary {
  list-style: none;
  cursor: pointer;
  padding: 2rem 2rem;
  user-select: none;
  position: relative;
  z-index: 1;
}

.repro-summary::-webkit-details-marker { display: none; }
.repro-summary::marker { display: none; }

.summary-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.summary-text { flex: 1; min-width: 0; }

.submit-title {
  font-size: clamp(1.25rem, 2.5vw, 1.625rem);
  font-weight: 800;
  margin: 0 0 0.4rem;
  color: var(--sl-color-text);
}

.submit-subtitle {
  font-size: 0.9375rem;
  color: var(--sl-color-gray-3);
  margin: 0;
  line-height: 1.55;
}

.summary-btn {
  display: inline-flex;
  align-items: center;
  padding: 0.55rem 1.1rem;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-weight: 600;
  white-space: nowrap;
  background: var(--sl-color-accent);
  color: #fff;
  box-shadow: 0 2px 12px color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
  flex-shrink: 0;
  transition: box-shadow 0.2s, transform 0.15s;
}

.repro-summary:hover .summary-btn {
  box-shadow: 0 4px 20px color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
  transform: translateY(-1px);
}

/* ── Form ── */
.repro-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.5rem 2rem 2rem;
  margin: 0 0.5rem;
  border-top: 1px solid var(--sl-color-hairline);
  position: relative;
  z-index: 1;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  align-items: start;
}

@media (max-width: 480px) {
  .form-row { grid-template-columns: 1fr; }
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  margin: 0 !important;
}

.form-field label {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--sl-color-gray-2);
  margin: 0 !important;
}

.form-field input,
.form-field textarea {
  padding: 0.5rem 0.75rem;
  border-radius: 0.375rem;
  border: 1px solid var(--sl-color-hairline);
  background: var(--sl-color-bg);
  color: var(--sl-color-text);
  font-size: 0.9rem;
  font-family: var(--sl-font);
  transition: border-color 0.2s;
  outline: none;
  resize: vertical;
  margin: 0 !important;
  box-sizing: border-box;
  width: 100%;
}

.form-field input:focus,
.form-field textarea:focus {
  border-color: var(--sl-color-accent);
}

.file-drop {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.375rem;
  padding: 1.5rem 1rem;
  border: 1.5px dashed var(--sl-color-hairline);
  border-radius: 0.5rem;
  background: var(--sl-color-bg);
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  text-align: center;
}

.file-drop.drag-over {
  border-color: var(--sl-color-accent);
  background: color-mix(in srgb, var(--sl-color-accent) 6%, var(--sl-color-bg));
}

.file-drop input[type="file"] { display: none; }

.drop-label {
  font-size: 0.875rem;
  color: var(--sl-color-gray-3);
}

.browse-link {
  color: var(--sl-color-accent);
  cursor: pointer;
  font-weight: 600;
  border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
}

.drop-hint {
  font-size: 0.775rem;
  color: var(--sl-color-gray-4);
  font-family: var(--sl-font-mono);
}

.form-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.submit-btn {
  display: inline-flex;
  align-items: center;
  padding: 0.6rem 1.4rem;
  border-radius: 0.375rem;
  font-size: 0.9375rem;
  font-weight: 600;
  background: var(--sl-color-accent);
  color: #fff;
  border: none;
  cursor: pointer;
  box-shadow: 0 2px 12px color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
  transition: transform 0.15s, box-shadow 0.2s;
}

.submit-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 20px color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
}

.form-note {
  font-size: 0.8rem;
  color: var(--sl-color-gray-4);
}
</style>
