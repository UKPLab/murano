---
import { Code } from '@astrojs/starlight/components';

const cards = [
  {
    tag: 'Guide',
    title: 'Record activations',
    description: 'Extract hidden states from any layer, module, or token position. Works on any HuggingFace causal LM out of the box.',
    href: '/docs/guides/record/',
    code: `acts = model.record(
    "The Eiffel Tower is in",
    layers=[10, 15, 20],
    position="last",
)
print(acts[15].shape)   # (1, 2048)`,
  },
  {
    tag: 'Guide',
    title: 'Find directions',
    description: 'Compute contrastive steering vectors from paired datasets. Murano picks the layer with the highest linear separation.',
    href: '/docs/guides/steer/',
    code: `direction = model.find_direction(
    positive=harmful_prompts,
    negative=harmless_prompts,
)
print(direction.best_layer)        # e.g. 12
print(direction.separation_scores) # {10: 1.3, 12: 3.4}`,
  },
  {
    tag: 'Guide',
    title: 'Steer generation',
    description: 'Ablate a concept by projecting it out of the residual stream, or amplify it with a scaled addition — both during generation.',
    href: '/docs/guides/patch/',
    code: `# Remove a concept
ablated = model.generate(prompt, ablate=direction)

# Amplify a concept
steered = model.generate(
    prompt, steer=(direction, 2.0)
)`,
  },
  {
    tag: 'Guide',
    title: 'Pipeline API',
    description: 'Compose steps into validated, reproducible experiment pipelines. Each step declares what it reads and writes — caught at config time.',
    href: '/docs/guides/pipeline/',
    code: `results = Pipeline([
    Load(dataset),
    Record(model, layers="all"),
    SteeringVector(normalize=True),
    Intervene(model, ablate_direction(...)),
    ComplianceRate(),
]).run()`,
  },
];
---

<section class="gallery-section">
  <div class="gallery-header">
    <p class="gallery-eyebrow">Capabilities</p>
    <h2 class="gallery-title">Everything you need for mech interp.</h2>
    <p class="gallery-subtitle">
      One coherent API for the full interpretability workflow — from
      raw activations to evaluated interventions.
    </p>
  </div>

  <div class="gallery-grid">
    {cards.map((card) => (
      <a class="gallery-card" href={card.href}>
        <div class="card-top">
          <span class="card-tag">{card.tag}</span>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-desc">{card.description}</p>
        </div>
        <div class="card-code">
          <Code code={card.code} lang="python" />
        </div>
        <span class="card-link">Read the guide →</span>
      </a>
    ))}
  </div>
</section>

<style>
.gallery-section {
  margin: 0 !important;
  padding: 4.5rem 0;
}

/* ── Section header ── */
.gallery-header {
  text-align: center;
  margin: 0 auto 2.5rem;
}

.gallery-eyebrow {
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--sl-color-accent);
  margin: 0 0 0.75rem;
}

.gallery-title {
  font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  font-weight: 800;
  line-height: 1.2;
  margin: 0 0 0.75rem;
  color: var(--sl-color-text);
}

.gallery-subtitle {
  font-size: 1.0625rem;
  color: var(--sl-color-gray-3);
  margin: 0;
  max-width: 52ch;
  margin-inline: auto;
}

/* ── Card grid ── */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

@media (max-width: 700px) {
  .gallery-grid {
    grid-template-columns: 1fr;
  }
}

/* ── Individual card ── */
.gallery-card {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.5rem;
  border: 1px solid var(--sl-color-hairline) !important;
  border-radius: 0.625rem;
  background: var(--sl-color-bg-nav);
  text-decoration: none !important;
  color: inherit;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
}

.gallery-card:hover {
  border-color: var(--sl-color-accent);
  box-shadow: 0 4px 20px color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  transform: translateY(-2px);
}

.card-top {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.card-tag {
  font-size: 0.75rem;
  font-weight: 600;
  font-family: var(--sl-font-mono);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--sl-color-accent);
}

.card-title {
  font-size: 1.125rem;
  font-weight: 700;
  margin: 0;
  color: var(--sl-color-text);
}

.card-desc {
  font-size: 0.9rem;
  color: var(--sl-color-gray-3);
  margin: 0;
  line-height: 1.6;
}

/* ── Code block inside card ── */
.card-code {
  border-radius: 0.375rem;
  overflow: hidden;
}

.card-code :global(.expressive-code) {
  --ec-brdRad: 0.375rem;
}
.card-code :global(.frame) {
  border: none !important;
  box-shadow: none !important;
}
.card-code :global(.frame .header) {
  display: none !important;
}
.card-code :global(pre) {
  font-size: 0.8rem !important;
}

/* ── Card link arrow ── */
.card-link {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--sl-color-accent);
}
</style>
