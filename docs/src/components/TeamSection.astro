---
const members = [
  {
    name: 'Alice Müller',
    role: 'Lead developer',
    affiliation: 'UKPLab, TU Darmstadt',
    github: 'https://github.com/ukplab',
    website: '',
    avatar: '',
  },
  {
    name: 'Bob Schmidt',
    role: 'Research engineer',
    affiliation: 'UKPLab, TU Darmstadt',
    github: 'https://github.com/ukplab',
    website: '',
    avatar: '',
  },
  {
    name: 'Charlie Weber',
    role: 'PhD student',
    affiliation: 'UKPLab, TU Darmstadt',
    github: 'https://github.com/ukplab',
    website: 'https://ukp.tu-darmstadt.de',
    avatar: '',
  },
];

const contact = {
  email: 'murano@ukp.tu-darmstadt.de',
  github: 'https://github.com/UKPLab/murano',
  lab: 'https://www.ukp.tu-darmstadt.de/',
  forum: 'https://github.com/UKPLab/murano/discussions',
  discord: 'https://discord.gg/your-invite',
  gallery: '/reproductions/',
};
---

<section class="team-section">
  <!-- Developer highlight -->
  <div class="team-header">
    <p class="team-eyebrow">People</p>
    <h2 class="team-title">Built by researchers, for researchers.</h2>
    <p class="team-subtitle">
      Murano is developed at <a href={contact.lab} target="_blank" rel="noopener">UKPLab</a>,
      TU Darmstadt — released under the MIT License.
    </p>
  </div>

  <div class="member-grid">
    {members.map((m) => (
      <div class="member-card">
        <div class="member-avatar">
          {m.avatar
            ? <img src={m.avatar} alt={m.name} width="64" height="64" />
            : <span class="avatar-placeholder">{m.name.split(' ').map((w: string) => w[0]).join('')}</span>
          }
        </div>
        <span class="member-name">{m.name}</span>
        <div class="member-links">
          {m.github && (
            <a href={m.github} class="member-link" target="_blank" rel="noopener" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
          )}
          {m.website && (
            <a href={m.website} class="member-link" target="_blank" rel="noopener" aria-label="Website">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- Contact & Social -->
  <div class="contact-block">
    <p class="contact-eyebrow">Contact &amp; Social</p>
    <div class="contact-links">
      <a href={`mailto:${contact.email}`} class="contact-chip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        {contact.email}
      </a>
      <a href={contact.github} class="contact-chip" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        UKPLab/murano
      </a>
      <a href={contact.forum} class="contact-chip" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Forum
      </a>
      <a href={contact.discord} class="contact-chip" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        Discord
      </a>
      <a href={contact.gallery} class="contact-chip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
        </svg>
        Reproduction Gallery
      </a>
      <a href={contact.lab} class="contact-chip" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        UKPLab · TU Darmstadt
      </a>
    </div>
  </div>
</section>

<style>
.team-section {
  margin: 0 !important;
  padding: 4.5rem 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rem;
}

/* ── Header ── */
.team-header {
  text-align: center;
}

.team-eyebrow {
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--sl-color-accent);
  margin: 0 0 0.75rem;
}

.team-title {
  font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  font-weight: 800;
  line-height: 1.2;
  margin: 0 0 0.75rem;
  color: var(--sl-color-text);
}

.team-subtitle {
  font-size: 1.0625rem;
  color: var(--sl-color-gray-3);
  margin: 0;
}

.team-subtitle a {
  color: var(--sl-color-accent);
  text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
  transition: border-color 0.2s;
}
.team-subtitle a:hover {
  border-bottom-color: var(--sl-color-accent);
}

/* ── Member grid ── */
.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
  align-items: flex-start;
  width: 100%;
}

.member-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  padding: 1.5rem 1.25rem 1.25rem;
  border: 1px solid var(--sl-color-hairline);
  border-radius: 0.75rem;
  background: var(--sl-color-bg-nav);
  width: 160px;
  text-align: center;
  margin: 0 !important;
}

/* ── Avatar ── */
.member-avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid var(--sl-color-hairline);
}

.member-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: color-mix(in srgb, var(--sl-color-accent) 15%, var(--sl-color-bg-nav));
  color: var(--sl-color-accent);
  font-size: 1.125rem;
  font-weight: 700;
  font-family: var(--sl-font-mono);
}

.member-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--sl-color-text);
}

/* ── Member links ── */
.member-links {
  display: flex;
  gap: 0.5rem;
  flex-shrink: 0;
}

.member-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 0.375rem;
  color: var(--sl-color-gray-3);
  text-decoration: none !important;
  border: none !important;
  transition: color 0.2s, background 0.2s;
}

.member-link:hover {
  color: var(--sl-color-accent);
  background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
}

/* ── Contact block ── */
.contact-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding-top: 2rem;
  border-top: 1px solid var(--sl-color-hairline);
}

.contact-eyebrow {
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--sl-color-gray-4);
  margin: 0;
}

.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.625rem;
  justify-content: center;
}

.contact-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.875rem;
  border-radius: 2rem;
  border: 1px solid var(--sl-color-hairline) !important;
  background: var(--sl-color-bg-nav);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--sl-color-gray-3);
  text-decoration: none !important;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}

.contact-chip:hover {
  border-color: var(--sl-color-accent) !important;
  color: var(--sl-color-accent);
  background: color-mix(in srgb, var(--sl-color-accent) 6%, var(--sl-color-bg-nav));
}
</style>
