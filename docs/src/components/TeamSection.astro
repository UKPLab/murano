---
const base = import.meta.env.BASE_URL;

interface Contributor {
  login: string;
  avatar_url: string;
  html_url: string;
  contributions: number;
  type: string;
}

let members: { name: string; github: string; avatar: string }[] = [];
try {
  const res = await fetch('https://api.github.com/repos/UKPLab/murano/contributors?per_page=100', {
    headers: {
      ...(process.env.GITHUB_TOKEN ? { Authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {}),
      Accept: 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28',
    },
  });
  if (res.ok) {
    const data: Contributor[] = await res.json();
    members = data
      .filter((c) => c.type === 'User')
      .sort((a, b) => b.contributions - a.contributions)
      .map((c) => ({ name: c.login, github: c.html_url, avatar: c.avatar_url }));
  } else {
    console.warn(`GitHub contributors fetch failed: ${res.status} ${res.statusText}`);
  }
} catch (err) {
  console.warn('GitHub contributors fetch error:', err);
}

const contact = {
  email: 'murano@ukp.tu-darmstadt.de',
  github: 'https://github.com/UKPLab/murano',
  lab: 'https://www.ukp.tu-darmstadt.de/',
  forum: 'https://github.com/UKPLab/murano/discussions',
  gallery: `${base}reproductions/`,
};
---

<section class="team-section">
  <!-- Developer highlight -->
  <div class="team-header">
    <p class="team-eyebrow">People</p>
    <h2 class="team-title">Built by researchers, for researchers.</h2>
    <p class="team-subtitle">
      Murano is developed at <a href={contact.lab} target="_blank" rel="noopener">UKPLab</a>,
      TU Darmstadt — released under the MIT License.
    </p>
  </div>

  {members.length > 0 && (
    <div class="member-grid">
      {members.map((m) => (
        <a class="member-card" href={m.github} target="_blank" rel="noopener">
          <div class="member-avatar">
            <img src={m.avatar} alt={m.name} width="64" height="64" loading="lazy" />
          </div>
          <span class="member-name">{m.name}</span>
        </a>
      ))}
    </div>
  )}

  <!-- Contact & Social -->
  <div class="contact-block">
    <p class="contact-eyebrow">Contact &amp; Social</p>
    <div class="contact-links">
      <a href={`mailto:${contact.email}`} class="contact-chip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        {contact.email}
      </a>
      <a href={contact.github} class="contact-chip" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        UKPLab/murano
      </a>
      <a href={contact.forum} class="contact-chip" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Forum
      </a>
      <a href={contact.gallery} class="contact-chip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
        </svg>
        Reproduction Gallery
      </a>
      <a href={contact.lab} class="contact-chip" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        UKPLab · TU Darmstadt
      </a>
    </div>
  </div>
</section>

<style>
.team-section {
  margin: 0 !important;
  padding: 4.5rem 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rem;
}

/* ── Header ── */
.team-header {
  text-align: center;
}

.team-eyebrow {
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--sl-color-accent);
  margin: 0 0 0.75rem;
}

.team-title {
  font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  font-weight: 800;
  line-height: 1.2;
  margin: 0 0 0.75rem;
  color: var(--sl-color-text);
}

.team-subtitle {
  font-size: 1.0625rem;
  color: var(--sl-color-gray-3);
  margin: 0;
}

.team-subtitle a {
  color: var(--sl-color-accent);
  text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
  transition: border-color 0.2s;
}
.team-subtitle a:hover {
  border-bottom-color: var(--sl-color-accent);
}

/* ── Member grid ── */
.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
  align-items: flex-start;
  width: 100%;
}

.member-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  padding: 1.5rem 1.25rem 1.25rem;
  border: 1px solid var(--sl-color-hairline);
  border-radius: 0.75rem;
  background: var(--sl-color-bg-nav);
  width: 160px;
  text-align: center;
  margin: 0 !important;
  text-decoration: none !important;
  color: var(--sl-color-text);
  transition: border-color 0.2s, transform 0.15s;
}

.member-card:hover {
  border-color: var(--sl-color-accent);
  transform: translateY(-2px);
}

/* ── Avatar ── */
.member-avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid var(--sl-color-hairline);
}

.member-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: color-mix(in srgb, var(--sl-color-accent) 15%, var(--sl-color-bg-nav));
  color: var(--sl-color-accent);
  font-size: 1.125rem;
  font-weight: 700;
  font-family: var(--sl-font-mono);
}

.member-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--sl-color-text);
}

/* ── Member links ── */
.member-links {
  display: flex;
  gap: 0.5rem;
  flex-shrink: 0;
}

.member-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 0.375rem;
  color: var(--sl-color-gray-3);
  text-decoration: none !important;
  border: none !important;
  transition: color 0.2s, background 0.2s;
}

.member-link:hover {
  color: var(--sl-color-accent);
  background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
}

/* ── Contact block ── */
.contact-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding-top: 2rem;
  border-top: 1px solid var(--sl-color-hairline);
}

.contact-eyebrow {
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--sl-color-gray-4);
  margin: 0;
}

.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.625rem;
  justify-content: center;
}

.contact-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.875rem;
  border-radius: 2rem;
  border: 1px solid var(--sl-color-hairline) !important;
  background: var(--sl-color-bg-nav);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--sl-color-gray-3);
  text-decoration: none !important;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}

.contact-chip:hover {
  border-color: var(--sl-color-accent) !important;
  color: var(--sl-color-accent);
  background: color-mix(in srgb, var(--sl-color-accent) 6%, var(--sl-color-bg-nav));
}
</style>
