---
import ReproLayout from '../../layouts/ReproLayout.astro';
import ReproCard from '../../components/ReproCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const reproductions = [
  {
    slug: 'ioi',
    title: 'Interpretability in the Wild: a Circuit for Indirect Object Identification in GPT-2 Small',
    venue: 'ICLR 2023',
    authors: 'Wang, Variengien, Conmy, Shlegeris, Steinhardt',
    description: 'Reverse-engineers how GPT-2 small identifies the indirect object, localizing the name-mover, negative name-mover, and S-inhibition heads. Reproduced with Murano path patching, attention analysis, and OV circuits.',
    tags: ['circuits', 'attention', 'path patching'],
    paper: 'https://arxiv.org/abs/2211.00593',
    code: 'https://github.com/redwoodresearch/Easy-Transformer',
  },
  {
    slug: 'geometry_of_truth',
    title: 'The Geometry of Truth: Emergent Linear Structure in LLM Representations of True/False Datasets',
    venue: 'arXiv 2023',
    authors: 'Marks, Tegmark',
    description: 'Shows that the truth of a factual statement is encoded as a single linear direction in the residual stream: true and false statements separate, a mass-mean probe reads the direction, it generalizes across topics, and adding it flips the model\'s judgement. Reproduced with Murano recording, probing, and interventions.',
    tags: ['probing', 'representations', 'steering'],
    paper: 'https://arxiv.org/abs/2310.06824',
    code: 'https://github.com/saprmarks/geometry-of-truth',
  },
  {
    slug: 'function_vectors',
    title: 'Function Vectors in Large Language Models',
    venue: 'ICLR 2024',
    authors: 'Todd, Li, Sen Sharma, Mueller, Wallace, Bau',
    description: 'Shows that a small set of attention heads carry a compact, portable representation of an in-context task: summing their outputs gives a function vector, and adding it to a zero-shot prompt makes GPT-J perform the task. Reproduced with Murano recording, causal mediation, and interventions.',
    tags: ['in-context learning', 'causal mediation', 'steering'],
    paper: 'https://arxiv.org/abs/2310.15213',
    code: 'https://github.com/ericwtodd/function_vectors',
  },
  {
    slug: 'tmlr2026',
    title: 'Shape Happens: Automatic Feature Manifold Discovery in LLMs via Supervised Multi-Dimensional Scaling',
    venue: 'TMLR 2026',
    authors: 'Tiblias, Bigoulaeva, Niu, Balloccu, Gurevych',
    description: 'Introduces SMDS, a framework for discovering and comparing geometric hypotheses about how LLMs organize features in latent space. Shows that feature manifolds form circles, chains, and clusters reflecting the semantic structure of the encoded concept.',
    tags: ['probing', 'representations', 'geometry'],
    paper: 'https://arxiv.org/abs/2510.01025',
    code: 'https://github.com/UKPLab/supervised-multidimensional-scaling',
  },
  {
    slug: 'feature_effect_geometry',
    title: 'Sparse Autoencoders Encode Both Concepts and Functions: The Downstream Geometry of Feature Effects',
    venue: 'arXiv 2026',
    authors: 'Hoang, Chatterjee, Chakraborty, Gurevych, Dutta',
    description:
      'Runs native Feature-Effect Geometry Analysis on an authored prompt set and actively rerenders compact source-derived geometry for every reported family.',
    tags: ['feature effects', 'geometry', 'SAE'],
    paper: 'https://arxiv.org/abs/2607.24645',
    code: 'https://github.com/UKPLab/FEGA',
  },
];
---

<ReproLayout title="Reproduction Gallery" description="Executable Murano studies of published mechanistic interpretability work.">
  <div class="gallery">
    <div class="gallery-header">
      <h1 class="gallery-title">Reproduction Gallery</h1>
      <p class="gallery-subtitle">
        Executable Murano studies of published interpretability work.
        Each entry states its scope and includes a notebook, paper reference, and walkthrough.
      </p>
    </div>

    <div class="gallery-grid">
      {reproductions.map((r) => (
        <ReproCard
          title={r.title}
          href={`${base}reproductions/${r.slug}`}
          venue={r.venue}
          authors={r.authors}
          description={r.description}
          tags={r.tags}
          paper={r.paper}
          code={r.code}
        />
      ))}

      <a href="https://github.com/UKPLab/murano/issues" class="card-empty" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
        <span class="empty-text">Your reproduction here.</span>
        <span class="empty-hint">Submit a notebook and we'll feature it in the gallery.</span>
      </a>
    </div>
  </div>
</ReproLayout>

<style>
.gallery {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.gallery-header {
  padding-top: 1rem;
}

.gallery-title {
  font-size: clamp(1.5rem, 3.5vw, 2rem);
  font-weight: 800;
  margin: 0 0 0.75rem;
}

.gallery-subtitle {
  font-size: 1rem;
  color: var(--sl-color-gray-3);
  margin: 0;
  max-width: 60ch;
  line-height: 1.6;
}

.gallery-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

.card-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 2rem;
  border: 1.5px dashed var(--sl-color-hairline);
  border-radius: 0.75rem;
  color: var(--sl-color-gray-4);
  text-align: center;
  text-decoration: none;
  min-height: 140px;
  transition: border-color 0.2s, color 0.2s;
}

.card-empty:hover {
  border-color: var(--sl-color-accent);
  color: var(--sl-color-accent);
}

.empty-text {
  font-size: 0.9375rem;
  font-weight: 600;
}

.empty-hint {
  font-size: 0.8125rem;
}
</style>
