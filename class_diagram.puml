@startuml
!theme plain

package "Core Models" {
  class MuranoModel {
      + model: LanguageModel
      + model_name: str
      + from_pretrained(model_name: str): MuranoModel
      + run_with_lens(prompt: str, lens: BaseLens, locations: List[LayerLocation]): dict
  }

  class BatchedMuranoModel {
      + run_recording(input, location: Location, **kwargs): dict
      + _stack_activations(obj): torch.Tensor
      + _stack_activations_recursive(obj): torch.Tensor
      + _get_dataloader(dataset: Dataset, batch_size: int): DataLoader
      + run_task(dataset: Dataset, location: List[LayerLocation], **kwargs): dict
  }
}

package "Location Abstractions" {
  class Location {
      + layers: List[int]
      + modules: List[str]
      + token_pos: Union[int, List[int], None]
      + __init__(layers, modules, token_pos)
      + __repr__(): str
      + get_slice_idx(slice: Location): tuple
      + is_valid_slice(slice: Location): bool
  }

  class LayerLocation {
      + layers: Union[slice, int, List[int]]
  }
}

package "Data Containers & Visualization" {
  class ActivationDataset {
      + activations: np.ndarray
      + location: Location
      + global_metadata: dict
      + dataset: Dataset
      + num_examples: int
      + num_layers: int
      + num_modules: int
      + seq_len: int
      + hidden_dim: int
      + __init__(activations, location, global_metadata, dataset)
      + __getitem__(slice: Location): np.ndarray
      + iloc(*idx): np.ndarray
      - _to_numpy(activations): np.ndarray
  }

  class PlotterLens {
      + reducer
      + save_path: str
      + label_columns: Union[str, List[str]]
      + __init__(reducer, save_path, label_columns)
      + observe(artifact: ActivationDataset, location, title: str)
  }
}

package "Lenses" {
  class BaseLens {
      + name: str
      + process(artifact: dict)
      + visualize(artifact: dict)
  }

  class LogitLens {
      + process(artifact: dict): dict
      + visualize(artifact: dict)
  }
}

package "External Dependencies" {
  class LanguageModel {
      + tokenizer
      + transformer
      + trace()
      + generate()
  }

  class Dataset {
      + map()
      + from_list()
  }

  class DataLoader {
      + collate_fn
      + __iter__()
  }
}

' Inheritance
MuranoModel <|-- BatchedMuranoModel
BatchedMuranoModel <|-- BatchedMuranoModel_Intervention
Location <|-- LayerLocation
BaseLens <|-- LogitLens

' Relationships across the pipeline
MuranoModel --> BaseLens : uses
MuranoModel --> LayerLocation : selects layers
MuranoModel o-- LanguageModel : wraps
MuranoModel --> LogitLens : ships default lens

BatchedMuranoModel --> Location : indexes activations
BatchedMuranoModel --> Dataset : maps/tokenizes
BatchedMuranoModel --> DataLoader : batches with collate_fn
BatchedMuranoModel --> ActivationDataset : produces artifacts

BatchedMuranoModel_Intervention --> ActivationDataset : injects activations
BatchedMuranoModel_Intervention --> Location : intervene/record slices

ActivationDataset o-- Location
ActivationDataset o-- Dataset
PlotterLens --> ActivationDataset : observe()
PlotterLens --> Location : slice selection
LogitLens --> ActivationDataset : post-process

' Helper & pipeline level functions
note right of BatchedMuranoModel
  Helper functions:
  - collate_fn(batch)
  - process_dataset(example, tokenizer, max_length)
end note

note right of BatchedMuranoModel_Intervention
  Standalone:
  compute_steering_vector(
      model, positive_dataset, negative_dataset,
      location, test_dataset, intervene_location,
      record_location, coeff, **kwargs)
end note

@enduml
